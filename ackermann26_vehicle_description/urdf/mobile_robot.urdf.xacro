<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_vehicle">
    
    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="mobile_robot_gazebo.xacro" />
    <xacro:include filename="vehicle_properties.xacro" />

    <!-- BASE LINK -->
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 ${wheel_radius}" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${chasis_length} ${chasis_width} ${chasis_height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${chasis_length} ${chasis_width} ${chasis_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${chasis_mass}" l="${chasis_length}" w="${chasis_width}" h="${chasis_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <!-- Steering Knuckles -->
    <xacro:steering_link prefix="front_right"/>
    <joint name="front_right_steering_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_right_steering_link"/>
        <origin xyz="0.128 -0.085 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5236" upper="0.5236" effort="1000" velocity="3.125"/>
    </joint>

    <xacro:steering_link prefix="front_left"/>
    <joint name="front_left_steering_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_left_steering_link"/>
        <origin xyz="0.128 0.085 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5236" upper="0.5236" effort="1000" velocity="3.125"/> 
    </joint>

    <!-- Wheels -->
    <xacro:wheel_link prefix="rear_left"/>
    <xacro:wheel_link prefix="rear_right"/>
    <xacro:wheel_link prefix="front_left"/>
    <xacro:wheel_link prefix="front_right"/>

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel_link"/>
        <origin xyz="-0.130 0.085 0" rpy="1.57 0.0 0.0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel_link"/>
        <origin xyz="-0.130 -0.085 0" rpy="1.57 0.0 0.0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="front_left_steering_link"/>
        <child link="front_left_wheel_link"/>
        <origin xyz="0 0 0" rpy="1.57 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <mimic joint="rear_left_wheel_joint" multiplier="1.0" offset="0"/>
    </joint>

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="front_right_steering_link"/>
        <child link="front_right_wheel_link"/>
        <origin xyz="0 0 0" rpy="1.57 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <mimic joint="rear_right_wheel_joint" multiplier="1.0" offset="0"/>
    </joint>

    <!-- Axles -->
    <xacro:axle prefix="front_"/>
    <xacro:axle prefix="rear_"/>

    <joint name="front_axle_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_axle"/>
        <origin xyz="${chasis_length/2} 0.0 ${wheel_radius/14}" rpy="1.57 0.0 0.0"/>
        
        <!-- <origin xyz="0.13 0.0 0.031" rpy="1.57 0.0 0.0"/> -->
    </joint>

    <joint name="rear_axle_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rear_axle"/>
        <origin xyz="-${chasis_length/2} 0.0 ${wheel_radius/14}" rpy="1.57 0.0 0.0"/>
    </joint>

    <!-- Cameras -->
    <xacro:csi prefix="front_"/>
    <xacro:csi prefix="rear_"/>
    <xacro:csi prefix="left_"/>
    <xacro:csi prefix="right_"/>

    <joint name="csi_front_axle_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_csi"/>
        <origin xyz="0.193 0.0 0.0953" rpy="-1.57 0 -1.57"/>
    </joint>

    <joint name="csi_rear_axle_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rear_csi"/>
        <origin xyz="-0.165 0.0 0.0953" rpy="-1.57 0 1.57"/>
    </joint>

    <joint name="csi_left_joint" type="fixed">
        <parent link="base_link"/>
        <child link="left_csi"/>
        <origin xyz="0.014 0.0438 0.0953" rpy="-1.57 0 0"/>
    </joint>

    <joint name="csi_right_joint" type="fixed">
        <parent link="base_link"/>
        <child link="right_csi"/>
        <origin xyz="0.014 -0.0674 0.0953" rpy="-1.57 0 3.1416"/>
    </joint>

    <!-- IMU -->
    <link name="IMU">
        <visual>
            <geometry>
                <box size="${imu_length} ${imu_width} ${imu_height}"/>
            </geometry>
            <material name="red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${imu_length} ${imu_width} ${imu_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${imu_mass}" l="${imu_length}" w="${imu_width}" h="${imu_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="IMU"/>
        <origin xyz="0.1278 0.0223 0.0895" rpy="0 0 0"/>
    </joint>

    <link name="realsense_rear">
        <visual>
            <geometry>
                <box size="${rgbd_length} ${rgbd_width} ${rgbd_height}"/>
            </geometry>
            <material name="cyan">
                <color rgba="0.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${rgbd_length} ${rgbd_width} ${rgbd_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${rgbd_mass}" l="${rgbd_length}" w="${rgbd_width}" h="${rgbd_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="realsense_rear_joint" type="fixed">
        <parent link="base_link"/>
        <child link="realsense_rear"/>
        <origin xyz="0.0822 -0.0001 0.1582" rpy="-1.57 0 -1.57"/>
    </joint>

    <link name="lidar">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
            <material name="green">
                <color rgba="0.0 1.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" l="${lidar_length}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar"/>
        <origin xyz="-0.0108 -0.0001 0.186" rpy="0 0 1.57"/>
    </joint>

</robot>