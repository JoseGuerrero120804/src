<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_vehicle_properties">

    <!-- Xacro properties -->
    <xacro:property name="wheel_width" value="0.022"/>
    <xacro:property name="wheel_radius" value="0.033"/>
    <xacro:property name="wheel_mass" value="0.05"/>

    <xacro:property name="chasis_length" value="0.256"/>
    <xacro:property name="chasis_width" value="0.148"/>
    <xacro:property name="chasis_height" value="0.022"/>
    <xacro:property name="chasis_mass" value="1.0"/>

    <xacro:property name="csi_radius" value="0.01" />
    <xacro:property name="csi_length" value="0.02" />
    <xacro:property name="csi_mass" value="0.01" />

    <xacro:property name="axle_radius" value="0.003" />
    <xacro:property name="axle_length" value="0.148" />
    <xacro:property name="axle_mass" value="0.02" />

    <xacro:property name="steering_radius" value="0.005" />
    <xacro:property name="steering_length" value="0.02" />
    <xacro:property name="steering_mass" value="0.005" />

    <xacro:property name="imu_mass" value="0.005"/>
    <xacro:property name="imu_length" value="0.035"/>
    <xacro:property name="imu_width" value="0.03"/>
    <xacro:property name="imu_height" value="0.0001"/>

    <xacro:property name="rgbd_mass" value="0.072"/>
    <xacro:property name="rgbd_length" value="0.0883"/>
    <xacro:property name="rgbd_width" value="0.0255"/>
    <xacro:property name="rgbd_height" value="0.0229"/>

    <xacro:property name="lidar_mass" value="0.2"/>
    <xacro:property name="lidar_radius" value="0.0376"/>
    <xacro:property name="lidar_length" value="0.0384"/>

    <!-- Axle MACRO -->
    <xacro:macro name="axle" params="prefix">
        <link name="${prefix}axle">
            <visual>
                <geometry>
                    <cylinder radius="${axle_radius}" length="${axle_length}"/>
                </geometry>
                <material name="green">
                    <color rgba="0.0 1.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.006 0.006 0.148"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${axle_mass}" r="${axle_radius}" l="${axle_length}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>
    </xacro:macro>

    <!-- Camera MACRO -->
    <xacro:macro name="csi" params="prefix">
        <link name="${prefix}csi">
           <visual>
            <geometry>
                <cylinder radius="${csi_radius}" length="${csi_length}"/>
            </geometry>
            <material name="green">
                <color rgba="0.0 1.0 0.0 1.0"/>
            </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.02 0.02"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${csi_mass}" r="${csi_radius}" l="${csi_length}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>
    </xacro:macro>

    <!-- Wheel MACRO -->
    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>
    </xacro:macro>

    <!-- Steering Knuckles MACRO -->
    <xacro:macro name="steering_link" params="prefix">
        <link name="${prefix}_steering_link">
            <visual>
                <geometry>
                    <cylinder radius="${steering_radius}" length="${steering_length}"/>
                </geometry>
                <material name="red">
                    <color rgba="1.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${steering_radius}" length="${steering_length}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${steering_mass}" r="${steering_radius}" l="${steering_length}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>
    </xacro:macro>

</robot>
